<!DOCTYPE html>
<html>
<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width">

	<title>{ifset title}{include title|stripHtml} | {/ifset}Putování za Malých princem</title>

	<link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.4.1/css/bootstrap.min.css" integrity="sha384-Vkoo8x4CGsO3+Hhxv8T/Q5PaXtkKtu6ug5TOeNV6gBiFeWPGFN9MuhOf23Q9Ifjh" crossorigin="anonymous">
	<link rel="stylesheet" href="{$basePath}/css/styles.css">
		{block scripts}
			<script src="{$basePath}/js/jquery-3.4.1.min.js"></script>
			<script src="{$basePath}/js/netteForms.min.js"></script>
			<script src="{$basePath}/js/nette.ajax.js"></script> {* Nette Ajax depens on jQuery *}
			<script src="https://unpkg.com/konva@4.2.2/konva.min.js"></script>

			{if $presenter->isLinkCurrent('Map:*')}
				<script src="{$basePath}/lib/plan.js"></script>
				<script src="{$basePath}/lib/planet.js"></script>
				<script src="{$basePath}/lib/pilot.js"></script>
				<script src="{$basePath}/lib/action.js"></script>
				<link rel="stylesheet" type="text/css" href="{$basePath}/css/activity.css" />
			{/if}

		{/block}
		<title>Malý princ</title>
		<script>
		$(function () {
		$.nette.init();
		});
		</script>
</head>

<body n:class="!$presenter->isLinkCurrent('Map:*') ? journal">
	{if !$presenter->isLinkCurrent('Map:*')}
  <div id='menu' class="menu">
    {if $user->loggedIn}
      <a n:href="Denik:" {$presenter->isLinkCurrent('Denik:') ? active}><button class="menu__btn">Průkaz</button></a>
      <a n:href="Denik:zivot" {$presenter->isLinkCurrent('Denik:zivot') ? active} ><button class="menu__btn">Systém podpory života</button></a>
      <a n:href="Denik:objevy" {$presenter->isLinkCurrent('Denik:objevy') ? active} ><button class="menu__btn">Objevy</button></a>
      {* <a n:href="Denik:navigace">Navigace</a> *}
      {* <a n:href="Denik:denni">denní zápis</a> *}
      <a n:href="Denik:pratele" {$presenter->isLinkCurrent('Denik:pratele') ? active} ><button class="menu__btn">Přátelé</button></a>
      <a n:href="Denik:statistiky" {$presenter->isLinkCurrent('Denik:statistiky') ? active} ><button class="menu__btn">Statistiky</button></a> 
      <a n:href="Sign:out"><button class="menu__btn">Odhlásit se</button></a>
      <a n:href="Map:default" class="menu__signOut"><img src="https://malyprincolomouc.cz/assets/close.png"></a>
    {else}
      <a n:href="Sign:in"><button class="menu__btn">Přihlásit se</button></a>
      <a n:href="Sign:register"><button class="menu__btn">Registrovat</button></a>
      <a n:href="Sign:forgot"><button class="menu__btn">Zapomenuté heslo</button></a>
      <div class="logo"><img src="https://malyprincolomouc.cz/assets/logo--inverted.png"></div>
    {/if}
  </div>
  {/if}

  {include content}
  <div n:foreach="$flashes as $flash" n:class="flash, $flash->type">{$flash->message}</div>


	<script src="https://cdn.jsdelivr.net/npm/popper.js@1.16.0/dist/umd/popper.min.js" integrity="sha384-Q6E9RHvbIyZFJoft+2mJbHaEWldlvI9IOYy5n3zV9zzTtmI3UksdQRVvoxMfooAo" crossorigin="anonymous"></script>
	<script src="https://stackpath.bootstrapcdn.com/bootstrap/4.4.1/js/bootstrap.min.js" integrity="sha384-wfSDF2E50Y2D1uUdj0O3uMBJnjuUD4Ih7YwaYd1iqfktj0Uod8GCExl3Og8ifwB6" crossorigin="anonymous"></script>
</body>
</html>
