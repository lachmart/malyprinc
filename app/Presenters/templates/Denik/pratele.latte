{block content}
  <div class="userFriends">
    <h1 n:block="title">Přátelé a pozvánky</h1>
    <div><a target="_blank" class="btn btn-dark" href="https://www.facebook.com/groups/217431993017100/">Skupina na Facebooku</a></div>

      {if $user->identity->isSkaut}
      <p class="userSubtitle mt-3">Pozvat přítele do hry (tohle vidí pouze skauti):</p>
      {control inviteForm}

      <p class="userSubtitle mt-3">Pozvaní přátelé:</p>
      <p n:foreach="$Invited as $item">{$item->invitedEmail}</p>
      <hr>
      {/if}

      <p class="userSubtitle mt-3">Sdílení polohy:</p>

      {control shareForm}

      <p class="userSubtitle mt-3">Sdílím polohu s:</p>

      <div class="container">
      {foreach $Shared as $item}
      <div class="row">
        <div class="col"><big>{$item->receiving->email}</big></div>
        <div class="col">
        {if $item->sharingActive}
         <a class="btn btn-dark" n:href="Denik:stopsharing $item->receivingUser">Přestat sdílet</a>
        {else}
         <a class="btn btn-outline-light" n:href="Denik:continuesharing $item->receivingUser">Obnovit sdílení</a>
        {/if}
      </div>

      </div>
      {/foreach}
      </div>

      <p class="userSubtitle mt-3">Sleduji polohu:</p>

      <div class="container">
      {foreach $Received as $item}
      <div class="row">
        <div class="col"><big>{$item->sharing->email}&nbsp</big></div>
        <div class="col">
        {if $item->receivingActive}
         <a class="btn btn-dark" n:href="Denik:stopreceiving $item->sharingUser">Vypnout sledování</a>
        {else}
         <a class="btn btn-outline-light" n:href="Denik:continuereceiving $item->sharingUser">Zapnout sledování</a>
        {/if}

        <a class="btn btn-dark" n:href="Denik:startsharingto $item->sharingUser">Taky sdílet</a>
        </div>
     </div>
    {/foreach}
  </div>
  </div>
{/block}
