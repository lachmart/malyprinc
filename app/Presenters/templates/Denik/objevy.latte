{block content}
 <div class="userDisc">
	<h1 n:block="title">Navštívené planety</h1>

		{foreach $planetsVisited as $key => $planet}
			Planeta číslo {$key} ({$planet['planet']->custom_name ? $planet['planet']->custom_name : $planet['planet']->name}) <br>
			{ifset $planet['activity']}
				{$planet['activity']->name}<br>
				{$planet['activity']->description}<br>

			{/ifset}


			{switch $planet['activityType']}
				{case 1}
					Zadej obrázek
										{control pictureForm-$key}
				{case 2}
					Zadej zvuk mp3
										{control soundForm-$key}

				{case 3}
					Zadej link
										{control linkForm-$key}
				{default}
						<p>Na této planetě tě nečeká žádný úkol<p>
			{/switch}

<hr/>
		{/foreach}

	<h1>Splněné planety</h1>

		{foreach $planetsDone as $key => $planet}
			{$key} => <br>
			{$planet['planet']->custom_name ? $planet['planet']->custom_name : $planet['planet']->name} <br>
			{$planet['activityType']}<br>{*generovat příslušný výstup *}
			{foreach $planet['data'] as $link}
				{$link->activityLink} <br>
			{/foreach}
		{/foreach}
  </div>
{/block}
