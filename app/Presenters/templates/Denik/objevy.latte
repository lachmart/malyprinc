{block content}
 <div class="userDisc">
	<h1 n:block="title">Planety k objevení (navštívené, nesplněné)</h1>

		{foreach $planetsVisited as $key => $planet}

      <h2>{$key} {$planet['planet']->custom_name ? $planet['planet']->custom_name : $planet['planet']->name} </h2>
      <br>
      <div class="" style="padding:20px">
			{ifset $planet['activity']}

  				<div><span class="specialTask">Úkol:</span>{$planet['activity']->name}</div>
  				{* <div><span class="specialTask">Popis:</span>{$planet['activity']->description|noescape}</div> *}
  				<div><span class="specialTask">Výstup:</span>{$planet['activity']->output|noescape}</div>
    			{switch $planet['activityType']}
    				{case 1}
    					<p class="userSubtitle mt-5">Zadej obrázek</p>
              <div class="form__fullWidth">
                {control pictureForm-$key}
              </div>
    				{case 2}
    					<p class="userSubtitle mt-5">Zadej zvuk mp3</p>
    										{control soundForm-$key}

    				{case 3}
    					<p class="userSubtitle mt-5">Zadej link</p>
    										{control linkForm-$key}
    				{default}
    				<div class="alert alert-warning" role="alert">
              Na této planetě tě nečeká žádný úkol
            </div>
    			{/switch}

      {/ifset}
    </div>

		{/foreach}
    {if !$planetsVisited}
      <h5>Na každé navšívené planetě jsi splnil zadaný úkol. Vydej se na další cestu!</h5>
    {/if}

<hr/>
	<h1 class="mt-5">Objevené planety</h1>

		{foreach $planetsDone as $key => $planet}

      <h2>{$key} {$planet['planet']->custom_name ? $planet['planet']->custom_name : $planet['planet']->name} </h2>
      <br>
      <div class="" style="padding:20px">
			{switch $planet['activityType']}
				{case 1} <!-- planeta s obrazkem jako ukol -->
				<!-- Gallery css-tricks.com/creating-a-modal-image-gallery-with-bootstrap-components/-->

					<div class="row" id="collapse{$key}" data-toggle="modal" data-target="#Modal{$key}">
						{foreach $planet['data'] as $image}
							<div class="col-6 col-sm-4 col-lg-2 col-xl-1">
								<img class="w-100 img-thumbnail" src="{$basePath}/{$image->activityLink}-thumb.jpg" alt="First slide" data-target="#carousel{$key}" data-slide-to="{$iterator->counter-1}">
                <figcaption class="text-center">{$image->user->nickname}</figcaption>
              </div>
						{/foreach}

					</div>

					<!-- Modal -->
					<!--
					This part is straight out of Bootstrap docs. Just a carousel inside a modal.
					-->
					<div class="modal fade" id="Modal{$key}" tabindex="-1" role="dialog" aria-hidden="true">
					<div class="modal-dialog modal-lg" role="document">
						<div class="modal-content">
							<div class="modal-header">
								<h5 class="modal-title text-dark">Objevy na planetě {$key} {$planet['planet']->custom_name ? $planet['planet']->custom_name : $planet['planet']->name}</h5>
								<button type="button" class="close" data-dismiss="modal" aria-label="Close">
									<span aria-hidden="true">&times;</span>
								</button>
							</div>
							<div class="modal-body">
								<div id="carousel{$key}" class="carousel slide" data-ride="carousel">
									<div class="carousel-inner">
										{foreach $planet['data'] as $image}
										<div class="carousel-item {if $iterator->first}active{/if}">
												<img class="d-block w-100" src="{$basePath}/{$image->activityLink}.jpg" >
                         <div class="carousel-caption d-none d-md-block " style="background: rgba(0, 0, 0, 0.6)">
                          <h2>{$image->user->nickname}</h2>
                        </div>
                    	</div>
										{/foreach}
									</div>
									<a class="carousel-control-prev" href="#carousel{$key}" role="button" data-slide="prev">
										<span class="carousel-control-prev-icon" aria-hidden="true"></span>
										<span class="sr-only">Previous</span>
									</a>
									<a class="carousel-control-next" href="#carousel{$key}" role="button" data-slide="next">
										<span class="carousel-control-next-icon" aria-hidden="true"></span>
										<span class="sr-only">Next</span>
									</a>
								</div>
							</div>
						</div>
					</div>
					</div>
				{case 2}
        <div class="row collapse" id="collapse{$key}" data-toggle="modal" data-target="#Modal{$key}">
          {foreach $planet['data'] as $sound}
            zvukový úkol
          {/foreach}
        </div>
				{case 3}
        <div class="row collapse" id="collapse{$key}" data-toggle="modal" data-target="#Modal{$key}">
  				{foreach $planet['data'] as $link}
  					<div class="col-12 col-sm-6 col-lg-3">
  						<a href="{$link->activityLink}" target="_blank">{$link->uset->nickname}</a>
  					</div>
  				{/foreach}
        </div>
				{default}
						<p>Tohle bys neměl vidět<p>
			{/switch}
</div>
		{/foreach}
  </div>
{/block}
