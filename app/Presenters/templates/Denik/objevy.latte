{block content}
 <div class="userDisc">
	<h1 n:block="title">Navštívené planety</h1>

		{foreach $planetsVisited as $key => $planet}
			<p class="userSubtitle">Planeta číslo {$key} ({$planet['planet']->custom_name ? $planet['planet']->custom_name : $planet['planet']->name})</p>
			{ifset $planet['activity']}
				<div><span class="specialTask">Název:</span>{$planet['activity']->name}</div>
				<div><span class="specialTask">Popis:</span>{$planet['activity']->description}</div>


			{/ifset}


			{switch $planet['activityType']}
				{case 1}
					<p class="userSubtitle mt-5">Zadej obrázek</p>
          <div class="form__fullWidth">
            {control pictureForm-$key}
          </div>
				{case 2}
					<p class="userSubtitle mt-5">Zadej zvuk mp3</p>
										{control soundForm-$key}

				{case 3}
					<p class="userSubtitle mt-5">Zadej link</p>
										{control linkForm-$key}
				{default}
				<div class="alert alert-warning" role="alert">
          Na této planetě tě nečeká žádný úkol
        </div>
			{/switch}

<hr/>
		{/foreach}

	<h1 class="mt-5">Splněné planety</h1>

		{foreach $planetsDone as $key => $planet}
			{$key} => <br>
			{$planet['planet']->custom_name ? $planet['planet']->custom_name : $planet['planet']->name} <br>
			{$planet['activityType']}<br>{*generovat příslušný výstup *}
			{foreach $planet['data'] as $link}
				{$link->activityLink} <br>
			{/foreach}
		{/foreach}
  </div>
{/block}
