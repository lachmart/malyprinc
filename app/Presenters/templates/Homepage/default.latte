{block content}
	 <div style="scroll-behavior: auto" id="lp_space"></div>

		<script>
		$(function () {
			lp_space.init();
		});
		</script>





		<a n:href="Homepage:fly 4" class="ajax">Fly! (json zdroj s parametry)</a>
			{* <a n:href="changeVariable!" class="ajax">Change variable!</a> *}


			{snippet ajaxChange}
				{$anyVariable}
			{/snippet}

			<a n:href="changeVariable!" class="ajax">Change variable! (using nette variables)</a>

<script>
$.getJSON( "ajax/fly",  { id: "John", time: "2pm" }, function( data ) {
  var items = [];
  $.each( data, function( key, val ) {
    items.push( "<li id='" + key + "'>" + val + "</li>" );
  });

  $( "<ul/>", {
    "class": "my-new-list",
    html: items.join( "" )
  }).appendTo( "body" );
});
</script>
{/block}
